{
  "name": "jobcodi-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "JobCodi Next.js frontend monorepo",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @jobcodi/web dev",
    "build": "pnpm --filter @jobcodi/web build",
    "lint": "pnpm --filter @jobcodi/web lint",
    "typecheck": "pnpm --filter @jobcodi/web typecheck",
    "start": "pnpm start:web",
    "start:web": "pnpm --filter @jobcodi/web start",
    "clean": "rimraf apps/*/.next apps/*/dist"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
